# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent scratch
/agent-tools

# blender render scratch
/blender/out/
/blender/*.blend
/blender/*.blend1
/blender/assets/
# Blender intermediates (rebuild with blender/build_poster.py)
/blender/out/
/blender/poster_studio.blend
/blender/assets/quarry_wall_*
/blender/assets/*.hdr

