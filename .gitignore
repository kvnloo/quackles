# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
.env.test*
.env.production*
.env.development*
!env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent scratch
/agent-tools

# Test artifacts (ephemeral verification reports, screenshots)
/artifacts

# Blender intermediates (rebuild with blender/build_poster.py)
/blender/out/
/blender/*.blend
/blender/*.blend1
/blender/assets/quarry_wall_*
/blender/assets/*.hdr
/blender/assets/apollo_source.jpg
/blender/assets/adam_full.jpg
/blender/assets/studio_small*

