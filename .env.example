# Environment variables for Quackles deployment

# Base path for the application (if deployed under a subpath)
# NEXT_PUBLIC_BASE_PATH=

# External origin for sequence/assets (tiles, frame images).
# Set to the root URL that contains blue/, white/, dark/, night/ directories.
# Examples:
#   GitHub Pages: https://kvnloo.github.io/quackles-assets
#   Vercel Blob:   https://<store>.public.blob.vercel-storage.com
#   Local dev:     (leave empty for same-origin resolution)
#
# When empty, assets resolve relative to the manifest/app origin.
# When set, only this origin AND the manifest/app origin are allowed
# (see lib/paths.ts assertAllowedAssetOrigin for the security boundary).
NEXT_PUBLIC_ASSET_ORIGIN=https://kvnloo.github.io/quackles-assets

# Vercel OIDC token for CLI authentication (do not commit this file with a real value)
# VERCEL_OIDC_TOKEN=

# Vercel Blob read/write token for asset uploads (do not commit this file with a real value)
# BLOB_READ_WRITE_TOKEN=

# Build-time metadata (set automatically by the build script; do not edit)
# NEXT_PUBLIC_BUILD_SHA=
# NEXT_PUBLIC_BUILD_TIME=
