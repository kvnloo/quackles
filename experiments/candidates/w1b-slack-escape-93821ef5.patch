diff --git a/lib/sequence/render.ts b/lib/sequence/render.ts
index 7eb2d3b..d9cfab5 100644
--- a/lib/sequence/render.ts
+++ b/lib/sequence/render.ts
@@ -132,14 +132,27 @@ export function cropInside(inner: Crop, outer: Crop, inset = 0): boolean {
 export const DETAIL_CANVAS_CAP = 4096;
 
 /** Grow the painted source rect until the backing store would exceed the cap. */
-/** Does a pan need a fresh detail paint? The inset repaints early, before the crop reaches the painted edge; a coverage side
- * already on the image boundary has nothing beyond it, so it takes no inset (else low zoom or an edge crop repaints forever). */
-export function cropEscapes(inner: Crop, outer: Crop, inset = 0): boolean {
-  const atStart = (v: number) => v <= 1e-9, atEnd = (v: number) => v >= 1 - 1e-9;
-  const left = atStart(outer.x) ? 0 : inset, top = atStart(outer.y) ? 0 : inset;
-  const right = atEnd(outer.x + outer.width) ? 0 : inset, bottom = atEnd(outer.y + outer.height) ? 0 : inset;
-  return inner.x < outer.x + left || inner.y < outer.y + top
-    || inner.x + inner.width > outer.x + outer.width - right || inner.y + inner.height > outer.y + outer.height - bottom;
+export type Insets = { left: number; top: number; right: number; bottom: number };
+/** Early-repaint inset per side, capped by the slack the paint had on that side (painted coverage beyond the crop). A side
+ * with no slack (image edge, or sharpPlan's budget/cap fallback where coverage == crop) cannot gain coverage by
+ * repainting, so it takes no inset; otherwise the same crop "escapes" forever and every render repaints. */
+export function slackInsets(paintedCrop: Crop, coverage: Crop, inset: number): Insets {
+  return {
+    left: Math.max(0, Math.min(inset, paintedCrop.x - coverage.x)),
+    top: Math.max(0, Math.min(inset, paintedCrop.y - coverage.y)),
+    right: Math.max(0, Math.min(inset, coverage.x + coverage.width - (paintedCrop.x + paintedCrop.width))),
+    bottom: Math.max(0, Math.min(inset, coverage.y + coverage.height - (paintedCrop.y + paintedCrop.height))),
+  };
+}
+/** Does a pan need a fresh detail paint? True when the crop leaves the painted coverage shrunk by the insets. A number
+ * applies to every side not already on the image boundary (nothing lies beyond it). */
+export function cropEscapes(inner: Crop, outer: Crop, inset: number | Insets = 0): boolean {
+  const eps = 1e-9;
+  const i = typeof inset === "number"
+    ? { left: outer.x <= eps ? 0 : inset, top: outer.y <= eps ? 0 : inset, right: outer.x + outer.width >= 1 - eps ? 0 : inset, bottom: outer.y + outer.height >= 1 - eps ? 0 : inset }
+    : inset;
+  return inner.x < outer.x + i.left - eps || inner.y < outer.y + i.top - eps
+    || inner.x + inner.width > outer.x + outer.width - i.right + eps || inner.y + inner.height > outer.y + outer.height - i.bottom + eps;
 }
 export function fittedBuffer(cssWidth: number, cssHeight: number, crop: Crop, dpr: number, cap = DETAIL_CANVAS_CAP, margin = 0.4): Crop {
   let pad = margin;
