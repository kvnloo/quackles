 #!/usr/bin/env node
 /** #53 contract: the detail layer repaints for a pan only when the crop can leave the painted coverage. A side of the coverage
  * that already reaches the image edge has nothing beyond it, so it needs no early-repaint inset. Before this, the 12% inset
- * on every side made a zoom < ~1.32 crop (or any crop on an image edge) "escape" forever: a full repaint on every render. */
+ * on every side made a zoom < ~1.32 crop (or any crop on an image edge) "escape" forever: a full repaint on every render.
+ * The same holds for any side the paint had no slack on (sharpPlan's budget/cap fallback paints coverage == crop), so the
+ * inset per side is capped by that side's slack at paint time. */
 import assert from "node:assert/strict";
-import { bufferedCrop, cropEscapes, inspectionCrop } from "../lib/sequence/render.ts";
+import { bufferedCrop, cropEscapes, inspectionCrop, slackInsets } from "../lib/sequence/render.ts";
 let n = 0; const test = (name, fn) => { fn(); n++; console.log("PASS", name); };
 const inset = (crop) => crop.width * 0.12;
 const painted = (zoom, x, y) => { const crop = inspectionCrop(zoom, x, y); return { crop, coverage: bufferedCrop(crop, 0.4) }; };
@@ -28,4 +30,19 @@ test("a crop outside the coverage always escapes", () => {
   const { crop, coverage } = painted(8, 0.2, 0.2);
   assert.equal(cropEscapes({ ...crop, x: crop.x + 0.3 }, coverage, inset(crop)), true);
 });
+test("no slack on a side (budget-limited coverage == crop): the same crop does not escape, a pan past it does", () => {
+  const crop = inspectionCrop(2.5, 0.5, 0.5), coverage = { ...crop }; // sharpPlan's margin-0 fallback
+  const insets = slackInsets(crop, coverage, inset(crop));
+  assert.deepEqual(insets, { left: 0, top: 0, right: 0, bottom: 0 });
+  assert.equal(cropEscapes(crop, coverage, insets), false);
+  assert.equal(cropEscapes({ ...crop, x: crop.x + 0.001 }, coverage, insets), true);
+});
+test("inset per side is capped by the slack the paint had on that side", () => {
+  const { crop, coverage } = painted(8, 0.5, 0.5);
+  const insets = slackInsets(crop, coverage, inset(crop));
+  for (const side of ["left", "top", "right", "bottom"]) assert.ok(Math.abs(insets[side] - inset(crop)) < 1e-12, side); // 40% buffer > 12% inset
+  const edge = painted(8, 0, 0.5), e = slackInsets(edge.crop, edge.coverage, inset(edge.crop));
+  assert.equal(e.left, 0);
+  assert.ok(e.right > 0);
+});
 console.log(`${n} passed`);
