{
  "name": "microduck-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43217 --hostname 0.0.0.0",
    "build": "NEXT_PUBLIC_BUILD_SHA=${NEXT_PUBLIC_BUILD_SHA:-local-preview} NEXT_PUBLIC_BUILD_TIME=${NEXT_PUBLIC_BUILD_TIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)} next build --webpack",
    "start": "next start --port 43217 --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "fps": "node scripts/fps-harness.mjs",
    "test:scroll": "node scripts/scroll-perf.mjs",
    "test": "npm run lint && npm run typecheck",
    "preview": "python3 -m http.server 43217 --bind 0.0.0.0 --directory out",
    "test:mobile": "node scripts/mobile-validation.mjs",
    "test:mobile:timing": "MODE=timing node scripts/mobile-validation.mjs",
    "test:mobile:visual": "MODE=visual node scripts/mobile-validation.mjs",
    "test:inspection-source": "node scripts/inspection-source-contracts.mjs",
    "test:request-budget": "node --import ./scripts/register-ts-resolve.mjs scripts/request-budget-contracts.mjs",
    "test:synced-theme": "node scripts/synced-theme-contracts.mjs",
    "test:motion-quality": "node scripts/motion-quality-contracts.mjs",
    "test:wheel": "node scripts/wheel-zoom-browser.mjs",
    "test:fling": "node scripts/fling-stress-browser.mjs",
    "test:blank-frames": "node scripts/blank-frame-browser.mjs",
    "test:wiring": "node scripts/wiring-contracts.mjs",
    "test:touch": "node scripts/touch-input-browser.mjs",
    "test:scroll-state": "node scripts/scroll-state-browser.mjs",
    "test:ui-stability": "node scripts/ui-stability-browser.mjs",
    "test:profiles": "node scripts/profile-browser.mjs",
    "test:resize": "node scripts/resize-placement-browser.mjs",
    "test:camera-arrival": "node scripts/camera-arrival-browser.mjs",
    "test:warm-plan": "node scripts/warm-plan-contracts.mjs",
    "test:inspection": "node scripts/inspection-browser.mjs",
    "test:inspection:static": "node scripts/run-inspection-static.mjs",
    "verify:deployed": "node scripts/hosting/verify.mjs",
    "register:gigapixel": "node scripts/register-gigapixel-dzi.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "three-mesh-bvh": "0.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright-core": "^1.63.0",
    "puppeteer-core": "^24.15.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
